{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "yochi-relay",
    "main": "cloudflare/worker.mjs",
    "compatibility_date": "2026-06-01",
    "durable_objects": {
        "bindings": [{ "name": "TUNNEL", "class_name": "TunnelDO" }]
    },
    // SQLite-backed Durable Objects run on the Workers Free plan.
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelDO"] }],
    // Serve on your own domain instead of *.workers.dev:
    // "routes": [{ "pattern": "relay.example.com", "custom_domain": true }],
    "vars": {
        // Optional. The registration key is a secret: `wrangler secret put RELAY_REGISTRATION_KEY`.
        // "MAX_STREAMS": "64"
    },
    "observability": { "enabled": true }
}
