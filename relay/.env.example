# Copy to .env. `yochi relay setup` fills this in for you.

# Public hostname of this relay; point its DNS A/AAAA record at this server.
RELAY_DOMAIN=relay.example.com

# Key a Gateway must present to register. Leave empty for an open relay
# (a Gateway is still only reachable with its 256-bit route token).
RELAY_REGISTRATION_KEY=

# Listen address of the relay process itself (Caddy talks to it).
# PORT=8787
# HOST=0.0.0.0

# Limits. 0 means no limit.
# MAX_GATEWAYS=1000     # Gateways connected at once
# MAX_STREAMS=64        # phone streams per Gateway
# STALL_TIMEOUT_S=60    # cut off a phone that reads nothing this long
# PING_INTERVAL_S=30
