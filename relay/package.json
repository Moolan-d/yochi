{
    "name": "yochi-relay",
    "version": "0.1.0",
    "private": true,
    "description": "Self-hosted relay between the Yochi app and its Gateway — Node/Docker or Cloudflare Workers. Forked from alma-relay.",
    "license": "MIT",
    "type": "module",
    "main": "index.mjs",
    "scripts": {
        "start": "node index.mjs",
        "test": "node test/relay.test.mjs",
        "test:cloudflare": "node test/relay.test.mjs --cloudflare",
        "dev:cloudflare": "wrangler dev",
        "deploy:cloudflare": "wrangler deploy"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "wrangler": "^4.20.0"
    }
}
