    "The terminal doesn't look as expected, so switching stopped. Check on the computer" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端画面和预期不一致，已停止切换，请在电脑上查看"
          }
        }
      }
    },
    "The terminal doesn't show the current mode. Switch on the computer" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
